# Base URL của TeachHub API, gồm cả /v1. Bắt buộc.
# 10.0.2.2 = máy host khi chạy Android emulator; iOS simulator dùng http://localhost:3000/v1.
TEACHHUB_API_URL=http://10.0.2.2:3000/v1
# SHA-256 pin của leaf certificate API, phân tách bằng dấu phẩy. Rỗng = không pin.
CERT_PINS=
# OAuth client ID loại "Web" — audience của id_token Google mà API xác minh.
GOOGLE_SERVER_CLIENT_ID=
