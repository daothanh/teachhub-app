          "sql": "CREATE TABLE IF NOT EXISTS \"cached_attendances\" (\"session_id\" TEXT NOT NULL, \"student_id\" TEXT NOT NULL, \"full_name\" TEXT NOT NULL, \"status\" TEXT NULL, \"note\" TEXT NULL, \"client_updated_at\" INTEGER NULL, PRIMARY KEY (\"session_id\", \"student_id\"));"
