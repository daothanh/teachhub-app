    {
      "name": "outbox_mutations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outbox_mutations\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"client_mutation_id\" TEXT NOT NULL UNIQUE, \"entity\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, \"client_updated_at\" INTEGER NOT NULL, \"attempt_count\" INTEGER NOT NULL DEFAULT 0, \"last_error\" TEXT NULL, \"session_id\" TEXT NULL, \"student_id\" TEXT NULL, \"batch_key\" TEXT NULL, \"batch_device_time\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "cached_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_sessions\" (\"id\" TEXT NOT NULL, \"class_id\" TEXT NOT NULL, \"class_name\" TEXT NOT NULL, \"session_date\" TEXT NOT NULL, \"starts_at\" INTEGER NOT NULL, \"ends_at\" INTEGER NOT NULL, \"status\" TEXT NOT NULL, \"is_makeup\" INTEGER NOT NULL CHECK (\"is_makeup\" IN (0, 1)), \"tz_offset_minutes\" INTEGER NULL, \"can_edit\" INTEGER NULL CHECK (\"can_edit\" IN (0, 1)), \"editable_until\" INTEGER NULL, \"roster_fetched_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "cached_attendances",
